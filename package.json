{
  "name": "agentspec",
  "version": "1.1.0",
  "description": "A tool for enhancing guided agentic development with structured specifications and workflows",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentspec": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "copy-templates": "cp -r src/templates dist/",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test": "jest"
  },
  "keywords": [
    "ai",
    "agent",
    "development",
    "specification",
    "workflow",
    "cli"
  ],
  "author": "AgentSpec",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ColtonMcInroy/agentspec.git"
  },
  "bugs": {
    "url": "https://github.com/ColtonMcInroy/agentspec/issues"
  },
  "homepage": "https://github.com/ColtonMcInroy/agentspec#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "QUICKSTART.md"
  ],
  "dependencies": {
    "commander": "^11.1.0",
    "ink": "^4.4.1",
    "ink-text-input": "^5.0.1",
    "ink-select-input": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^18.2.0",
    "chalk": "^4.1.2",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/fs-extra": "^11.0.4",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
